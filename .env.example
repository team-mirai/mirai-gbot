# OpenRouter API キー（Vercel の Environment Variables にも同じ名前で設定する）
OPENROUTER_API_KEY=
# 任意: 使うモデル（既定: openai/gpt-6-luna。大量アクセス向けに安価なモデル）
# OPENROUTER_MODEL=openai/gpt-6-luna
# 任意: Web 検索（OpenRouter の web プラグイン）。false で無効（既定: 有効）
# OPENROUTER_WEB_SEARCH=true
# 任意: 不正利用対策（0 で無効）。カウンタはインスタンスごとのメモリ上に持つため目安の上限
# RATE_LIMIT_PER_MINUTE=10   # IP あたり 1 分間のリクエスト上限
# RATE_LIMIT_PER_DAY=100     # IP あたり 1 日のリクエスト上限
# MAX_INPUT_CHARS=2000       # 1 メッセージの最大文字数（超えると 400）
# MAX_HISTORY_MESSAGES=20    # モデルに送る会話履歴の最大件数（古い分は切り捨て）
# MAX_HISTORY_CHARS=12000    # モデルに送る会話履歴の合計最大文字数
# 任意: 検索対象にするドメイン（カンマ区切り。サブドメインも含む。既定: go.jp,lg.jp）
# SEARCH_ALLOWED_DOMAINS=go.jp,lg.jp
