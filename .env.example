# OpenRouter API キー（Vercel の Environment Variables にも同じ名前で設定する）
OPENROUTER_API_KEY=
# 任意: 使うモデル（既定: openai/gpt-6-luna。大量アクセス向けに安価なモデル）
# OPENROUTER_MODEL=openai/gpt-6-luna
# 任意: Web 検索（モデル名に :online を付けて呼ぶ）。false で無効（既定: 有効）
# OPENROUTER_WEB_SEARCH=true
# 任意: /api/chat の IP ごとのレート制限（回/分）。0 で無効（既定: 10）
# RATE_LIMIT_PER_MINUTE=10
