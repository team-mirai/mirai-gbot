{
  "name": "app-local-about",
  "description": "ローカルで起動した G ボット本体に自分自身について質問し、名前・目的・運営者・利用料を正しく答えられるかを測る",
  "questions": "questions/about_bot.jsonl",
  "target": {
    "type": "http",
    "url": "http://localhost:3000/api/chat",
    "body_template": { "messages": [ { "role": "user", "content": "{{question}}" } ] },
    "answer_path": "answer",
    "citations_path": "citations",
    "timeout": 300
  },
  "judge": { "model": "anthropic/claude-opus-5.5", "temperature": 0 }
}
